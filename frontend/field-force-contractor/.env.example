# frontend/field-force-contractor/.env.example
# Copy this file to .env (gitignored) and restart Expo with
# `npx expo start --clear` so the new values are bundled.
# Expo inlines EXPO_PUBLIC_* values into the app bundle, so never put
# secrets in this file.

# Showcase mode (constants/showcase.ts). Off unless set to exactly "true".
# When on, Accept Ticket and Start Task skip the inspection, biometric/PIN,
# GPS proximity and PPE checks so the contractor flow can be demoed without
# biometric hardware or being at the job site. Keep it false for any build
# that uses real data.
# See DEMO_REVERT.md.
EXPO_PUBLIC_SHOWCASE_MODE=false
